[Unit]
Description=torrmedia library server
After=network-online.target qbittorrent.service
Wants=network-online.target

[Service]
Type=simple
User=torrmedia
Group=torrmedia
SupplementaryGroups=qbittorrent
EnvironmentFile=/etc/torrmedia/config.env
StateDirectory=torrmedia
StateDirectoryMode=0750
ExecStart=/usr/local/bin/torrmedia
Restart=on-failure
RestartSec=3
# On stop torrmedia lets running operations finish (a delete batch may be
# in the middle of a recheck) for up to TORRMEDIA_OPERATION_TIMEOUT + 30 s.
# The systemd default of 90 s would kill it halfway and leave the torrent
# stopped. Raise this if you raise TORRMEDIA_OPERATION_TIMEOUT.
TimeoutStopSec=6min
NoNewPrivileges=true
MemoryAccounting=true
MemoryHigh=256M
MemoryMax=384M
OOMScoreAdjust=500

[Install]
WantedBy=multi-user.target
